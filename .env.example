# Required for Gemini Instagram audits
GEMINI_API_KEY=your-gemini-api-key

# Required for admin-protected routes (publish, delete, settings write, etc.)
ADMIN_KEY=your-strong-admin-key

# Required for Hostinger PHP upload bridge (publish-prompt + profile images)
UPLOAD_HANDLER_KEY=your-upload-handler-key

# Instagram profile lookup (either name works; RAPIDAPI_KEY preferred)
RAPIDAPI_KEY=your-rapidapi-key
# INSTA_LOOTER_KEY=your-rapidapi-key

# Database — omit for local SQLite (./promptverse.db); set on Render for Postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated browser origins allowed by CORS (defaults cover local Vite + antimprompt.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://antimprompt.com,https://www.antimprompt.com

# Optional Gemini audit tuning
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# AUDIT_MAX_CONCURRENT=50
# AUDIT_CACHE_TTL=60
# AUDIT_CACHE_MAX=500

# Instagram Graph Business Discovery audit (v2 route)
IG_GRAPH_ACCESS_TOKEN=your-long-lived-meta-user-token
IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
# IG_GRAPH_API_VERSION=v26.0
