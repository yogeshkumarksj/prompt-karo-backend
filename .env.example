# Required for Gemini Instagram audits
GEMINI_API_KEY=your-gemini-api-key

# Required for admin-protected routes (publish, delete, settings write, etc.)
ADMIN_KEY=your-strong-admin-key

# Required for Hostinger PHP upload bridge (publish-prompt + profile images)
UPLOAD_HANDLER_KEY=your-upload-handler-key

# Instagram profile lookup.
# Numbered keys are tried first, RAPIDAPI_KEY_1 through RAPIDAPI_KEY_10.
# RAPIDAPI_KEY and INSTA_LOOTER_KEY are extra keys. Any one of these is enough.
# Duplicate values are ignored. A key that hits a quota or rate limit is skipped
# for RAPIDAPI_KEY_COOLDOWN_SECONDS (default 60) and the next key is used.
RAPIDAPI_KEY=your-rapidapi-key
# INSTA_LOOTER_KEY=your-rapidapi-key
# RAPIDAPI_KEY_1=your-rapidapi-key
# RAPIDAPI_KEY_2=your-rapidapi-key
# RAPIDAPI_KEY_3=your-rapidapi-key
# RAPIDAPI_KEY_4=your-rapidapi-key
# RAPIDAPI_KEY_5=your-rapidapi-key
# RAPIDAPI_KEY_6=your-rapidapi-key
# RAPIDAPI_KEY_7=your-rapidapi-key
# RAPIDAPI_KEY_8=your-rapidapi-key
# RAPIDAPI_KEY_9=your-rapidapi-key
# RAPIDAPI_KEY_10=your-rapidapi-key
# RAPIDAPI_KEY_COOLDOWN_SECONDS=60

# Database — omit for local SQLite (./promptverse.db); set on Render for Postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated browser origins allowed by CORS (defaults cover local Vite + antimprompt.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://antimprompt.com,https://www.antimprompt.com

# Optional Gemini audit tuning
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# AUDIT_MAX_CONCURRENT=50
# AUDIT_CACHE_TTL=60
# AUDIT_CACHE_MAX=500

# Instagram Graph Business Discovery audit (v2 route)
IG_GRAPH_ACCESS_TOKEN=your-long-lived-meta-user-token
IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
# IG_GRAPH_API_VERSION=v26.0

# Free-tier fallback for Viral Insta Songs and Viral AI Art Trends.
# Use a free-tier key. Leave either one blank and the other provider is used.
# GROQ_API_KEY=your-groq-key
# AI_PROVIDER_ORDER=gemini,groq
# FREE_GEMINI_MODELS=gemini-3.6-flash
# GROQ_MODELS=llama-3.3-70b-versatile

# Hard budget. When a cap is reached the API returns
# "Limit reached, try tomorrow." and does not call Gemini, Groq, RapidAPI, or Graph.
# AI_BUDGET_ENABLED=true
# AI_GLOBAL_DAILY_REQUEST_CAP=40
# AI_GLOBAL_MONTHLY_REQUEST_CAP=800
# AI_GLOBAL_DAILY_TOKEN_CAP=100000
# AI_GLOBAL_MONTHLY_TOKEN_CAP=1500000
# AI_RESERVE_TOKENS_PER_CALL=4000
# AI_FREE_USER_DAILY_LIMIT=5
# AI_PAID_USER_DAILY_LIMIT=5
# AI_CACHE_TTL_SECONDS=86400
# AI_CACHE_MAX=500
# AI_MAX_OUTPUT_TOKENS=1024
# AI_BLOCK_PAID_FEATURES=false
# AI_FEATURE_BILLING=insta-audit:paid,insta-audit-v2:paid,insta-audit-auto:paid,viral-insta-songs:free,viral-ai-art-trends:free
# AI_LIMIT_SALT=change-me
